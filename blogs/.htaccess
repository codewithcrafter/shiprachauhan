DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass existing real files through (css, js, images)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Route all blog article requests dynamically to blog.php
  RewriteRule ^([^/]+)/?$ ../blog.php?slug=$1 [NC,L,QSA]
</IfModule>