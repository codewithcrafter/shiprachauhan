# ==============================================================================
# SHIPRA CHAUHAN - UNIVERSAL ROUTING (.htaccess)
# ==============================================================================
Options -Indexes +FollowSymLinks
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Route admin
  RewriteRule ^admin/?$ admin/index.php [NC,L]

  # 2. Dynamic Blogs hub -> blogs.php
  RewriteRule ^blogs/?$ blogs.php [NC,L]

  # 3. Dynamic single blog post -> blog.php?slug=$1
  RewriteRule ^blogs/([^/]+)/?$ blog.php?slug=$1 [NC,L,QSA]

  # 4. Route /services and /services/ directly to services.html
  RewriteRule ^services/?$ services.html [NC,L]

  # 4. If actual file exists, serve it (css, js, assets, images)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. Route clean URLs to .php if exists
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.*)$ $1.php [NC,L]

  # 6. Route clean URLs to .html if exists (e.g. /ecommerce-seo -> ecommerce-seo.html)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [NC,L]

  # 7. Fallback to existing directory
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Browser Caching & Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/x-httpd-php "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
